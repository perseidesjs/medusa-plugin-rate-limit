{
	"name": "@perseidesjs/medusa-plugin-rate-limit",
	"version": "3.0.0-next.0",
	"description": "A simple rate-limit middleware for Medusa",
	"author": "adevinwild",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/perseidesjs/medusa-plugin-rate-limit.git"
	},
	"keywords": [
		"medusa",
		"medusa-plugin",
		"medusa-v2",
		"medusa-plugin-other",
		"rate-limit",
		"rate-limiting"
	],
	"main": "dist/index.js",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"build": "rimraf dist && tsc --build ./tsconfig.json",
		"build:publish": "rimraf dist && tsc --build ./tsconfig.build.json",
		"watch": "tsc --watch",
		"format": "biome format --write",
		"lint": "biome lint --write",
		"prepublishOnly": "npm run build",
		"release": "yarn build && changeset publish"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@changesets/cli": "^2.29.7",
		"@epic-web/config": "^1.21.3",
		"@medusajs/framework": "^2.10.3",
		"@mikro-orm/core": "6.5.6",
		"@mikro-orm/migrations": "6.5.6",
		"@mikro-orm/postgresql": "6.5.6",
		"@swc/core": "^1.13.20",
		"@types/ioredis": "^5.0.0",
		"ajv": "^8.17.1",
		"awilix": "^8.0.1",
		"cross-env": "^5.2.1",
		"express": "^4.21.2",
		"ioredis": "^5.8.0",
		"redis-memory-server": "^0.13.0",
		"rimraf": "^5.0.10",
		"supertest": "^7.1.4",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	},
	"peerDependencies": {
		"@medusajs/framework": "^2.10.3"
	},
	"packageManager": "yarn@4.9.4"
}